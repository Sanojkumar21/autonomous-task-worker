# Pick a model provider (free tiers work), or list several: the worker fails over to the next one when a
# model's daily budget runs out, mid-run, and the report names every model that worked on the run.
#   LLM=gemini:gemini-3.8-flash,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b
# Gemini (https://aistudio.google.com/apikey):
LLM=gemini:auto            # picks the newest Flash model your key can use; or name one, e.g. gemini:gemini-3.8-flash
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys): LLM=groq:openai/gpt-oss-120b
GROQ_API_KEY=

# Any OpenAI-compatible endpoint (OpenRouter, Ollama, OpenAI): LLM=openai_compat:<model>
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Anthropic: LLM=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=

# Where the simulated company runs
COMPANY_URL=http://127.0.0.1:8000
