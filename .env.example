# Pick one model provider. Free tiers work.
# Gemini (https://aistudio.google.com/apikey):
LLM=gemini:auto            # picks the newest Flash model your free key can use; or name one, e.g. gemini:gemini-2.5-flash
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys): LLM=groq:openai/gpt-oss-120b
GROQ_API_KEY=

# Any OpenAI-compatible endpoint (OpenRouter, Ollama, OpenAI): LLM=openai_compat:<model>
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Anthropic: LLM=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=

# Where the simulated company runs
COMPANY_URL=http://127.0.0.1:8000
